@model PyFinal_1.ViewModels.Reclamos.CrearReclamoVM
@using Microsoft.EntityFrameworkCore
@inject PyFinal_1.Data.ReclamosDbContext Db

@{
    Layout = null;
    ViewData["Title"] = "Nuevo Reclamo";

    var tipos = await Db.TiposReclamo
        .AsNoTracking()
        .OrderBy(t => t.NombreTipo)
        .Select(t => t.NombreTipo)
        .ToListAsync();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Nuevo Reclamo - Cliente360</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #101b3e;
            background: #f3f7ff;
        }

        .app {
            display: flex;
            min-height: 100vh;
        }

        /* MENU LATERAL */

        .sidebar {
            width: 260px;
            flex-shrink: 0;
            background: white;
            padding: 28px 14px;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 20px #dae5f550;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 9px;
            font-size: 22px;
            font-weight: 800;
            padding: 0 11px;
            margin-bottom: 55px;
            color: #0f1f4d;
            white-space: nowrap;
        }

        .logo-icon {
            width: 39px;
            height: 39px;
            flex-shrink: 0;
        }

        .logo-360 {
            color: #1e89ff;
        }

        .menu {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

            .menu a {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                color: #263c64;
                font-size: 16px;
                padding: 17px 20px;
                border-radius: 13px;
                transition: all .3s ease;
            }

                .menu a:hover {
                    background: #e9f3ff;
                    color: #0866f5;
                    transform: translateX(5px);
                }

                .menu a.active {
                    background: linear-gradient(120deg, #e8f2ff, #dff7ff);
                    color: #0866f5;
                    font-weight: 700;
                    border-left: 4px solid #0866f5;
                }

        .sidebar-bottom {
            margin-top: auto;
            padding: 20px;
            font-size: 14px;
        }

            .sidebar-bottom a {
                color: #0866f5;
                text-decoration: none;
                font-weight: 600;
            }

        .btn-logout {
            background: none;
            border: 0;
            padding: 0;
            font: inherit;
            color: #d94c60;
            font-weight: 700;
            cursor: pointer;
        }

        /* CONTENIDO PRINCIPAL */

        .workspace {
            flex: 1;
            min-width: 0;
        }

        .topbar {
            min-height: 82px;
            background: linear-gradient(110deg, #3288fb, #8fe4f4);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 18px 35px;
            color: white;
        }

            .topbar strong {
                font-size: 18px;
            }

        .account {
            background: #ffffffcc;
            color: #183762;
            border-radius: 30px;
            padding: 11px 20px;
            font-size: 14px;
        }

        .content {
            width: 100%;
            max-width: 1450px;
            margin: auto;
            padding: 35px;
        }

        /* ENCABEZADO */

        .hero {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 30px;
            animation: aparecer .6s ease both;
        }

            .hero h1 {
                font-size: 38px;
                margin: 0 0 10px;
                font-weight: 800;
            }

            .hero p {
                margin: 0;
                font-size: 17px;
                color: #7184a4;
            }

        .hero-icon {
            background: linear-gradient(135deg, #e1efff, #cff6fc);
            width: 95px;
            height: 95px;
            border-radius: 24px;
            display: grid;
            place-items: center;
            font-size: 45px;
            box-shadow: 0 8px 25px #bed4f560;
            animation: flotar 4s ease-in-out infinite;
        }

        /* DISTRIBUCION */

        .form-layout {
            display: grid;
            grid-template-columns: minmax(0, 1.7fr) minmax(280px, 1fr);
            gap: 24px;
            align-items: start;
        }

        .form-card,
        .preview-card,
        .help-card {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 8px 25px #dce6f54d;
            animation: aparecer .7s ease both;
        }

            .form-card h2,
            .preview-card h2 {
                margin: 0 0 9px;
                font-size: 23px;
            }

        .subtitle {
            color: #8190a8;
            font-size: 14px;
            margin-bottom: 27px;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            color: #183762;
            margin: 28px 0 20px;
        }

        .section-icon {
            background: #e8f2ff;
            color: #0866f5;
            width: 35px;
            height: 35px;
            border-radius: 10px;
            display: grid;
            place-items: center;
        }

        /* CAMPOS DEL FORMULARIO */

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .form-group {
            margin-bottom: 22px;
        }

            .form-group label {
                display: block;
                font-size: 14px;
                font-weight: 700;
                color: #263c64;
                margin-bottom: 9px;
            }

        .required {
            color: #ec4380;
        }

        .form-control {
            width: 100%;
            padding: 15px 16px;
            background: #f7faff;
            border: 1px solid #dce8f8;
            border-radius: 12px;
            font-family: inherit;
            font-size: 14px;
            color: #101b3e;
            outline: none;
            transition: all .3s ease;
        }

            .form-control:focus {
                background: white;
                border-color: #2583fc;
                box-shadow: 0 0 0 4px #2583fc1a;
                transform: translateY(-2px);
            }

            .form-control::placeholder {
                color: #9aabc2;
            }

        textarea.form-control {
            resize: vertical;
            min-height: 150px;
            line-height: 1.7;
        }

        .field-hint {
            color: #91a0b7;
            font-size: 12px;
            margin-top: 8px;
        }

        .counter {
            text-align: right;
            color: #8190a8;
            font-size: 12px;
            margin-top: 8px;
        }

        /* VALIDACIONES */

        .text-danger,
        .field-validation-error {
            color: #d62f50;
            display: block;
            font-size: 13px;
            margin-top: 7px;
        }

        .validation-summary-errors {
            background: #fff0f1;
            border: 1px solid #ffcbd2;
            color: #ac253e;
            padding: 13px 17px;
            border-radius: 12px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .validation-summary-valid {
            display: none;
        }

        /* EVIDENCIAS */

        .evidence-box {
            border: 2px dashed #cbdcf5;
            background: #f8fbff;
            border-radius: 15px;
            padding: 25px;
            text-align: center;
        }

        .evidence-icon {
            font-size: 31px;
            margin-bottom: 10px;
        }

        .evidence-box strong {
            display: block;
            font-size: 15px;
            margin-bottom: 7px;
        }

        .evidence-box p {
            margin: 0;
            color: #8190a8;
            font-size: 13px;
        }

        .coming-soon {
            display: inline-block;
            margin-top: 12px;
            padding: 6px 12px;
            background: #e8effa;
            border-radius: 20px;
            color: #607493;
            font-size: 12px;
        }

        /* BOTONES */

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 15px;
            margin-top: 30px;
            padding-top: 25px;
            border-top: 1px solid #e8edf5;
        }

        .btn-cancelar,
        .btn-registrar {
            padding: 15px 25px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            transition: all .3s ease;
            text-align: center;
        }

        .btn-cancelar {
            background: #f0f4fb;
            color: #536987;
            border: 1px solid #e0e7f2;
        }

            .btn-cancelar:hover {
                background: #e4ebf7;
                transform: translateY(-2px);
            }

        .btn-registrar {
            background: linear-gradient(120deg, #2583fc, #0056f5);
            border: none;
            color: white;
            box-shadow: 0 5px 15px #0866f53d;
        }

            .btn-registrar:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px #0866f577;
            }

        /* VISTA PREVIA */

        .right-column {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .preview-card {
            animation-delay: .15s;
        }

        .preview-heading {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

            .preview-heading h2 {
                margin: 0;
            }

        .preview-icon {
            width: 45px;
            height: 45px;
            background: #e8f2ff;
            border-radius: 12px;
            display: grid;
            place-items: center;
            font-size: 24px;
        }

        .preview-box {
            background: linear-gradient(145deg, #f3f8ff, #eaf4ff);
            border: 1px solid #dfeafa;
            border-radius: 16px;
            padding: 22px;
        }

        .preview-label {
            display: block;
            color: #7e90ad;
            font-size: 12px;
            margin-bottom: 6px;
        }

        .preview-value {
            display: block;
            color: #183762;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 18px;
            overflow-wrap: anywhere;
        }

        .preview-description {
            font-weight: 400;
            white-space: pre-wrap;
            line-height: 1.6;
        }

        .badge-estado {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: #e4ebf5;
            color: #516687;
            padding: 8px 13px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 700;
        }

            .badge-estado::before {
                content: "";
                height: 8px;
                width: 8px;
                border-radius: 50%;
                background: currentColor;
            }

        .preview-note {
            font-size: 13px;
            color: #8190a8;
            line-height: 1.6;
            margin-top: 18px;
        }

        /* TARJETA DE AYUDA */

        .help-card {
            background: linear-gradient(140deg, #eaf4ff, #e3faff);
            animation-delay: .25s;
        }

            .help-card h3 {
                margin: 0 0 10px;
                font-size: 19px;
            }

            .help-card p {
                color: #607493;
                font-size: 14px;
                line-height: 1.7;
                margin-bottom: 12px;
            }

        /* ANIMACIONES */

        @@keyframes aparecer {
            from {
                opacity: 0;
                transform: translateY(25px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes flotar {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-9px);
            }
        }

        /* RESPONSIVE */

        @@media (max-width: 1150px) {
            .form-layout {
                grid-template-columns: 1fr;
            }

            .right-column {
                display: grid;
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 750px) {
            .app {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                padding: 15px;
            }

            .logo {
                margin-bottom: 15px;
            }

            .menu {
                flex-direction: row;
                overflow-x: auto;
            }

                .menu a {
                    white-space: nowrap;
                }

            .sidebar-bottom {
                display: none;
            }

            .content {
                padding: 20px;
            }

            .hero h1 {
                font-size: 29px;
            }

            .hero-icon {
                display: none;
            }

            .form-row,
            .right-column {
                grid-template-columns: 1fr;
            }

            .form-card,
            .preview-card,
            .help-card {
                padding: 20px;
            }

            .form-actions {
                flex-direction: column;
            }

            .topbar {
                padding: 20px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation: none !important;
                transition: none !important;
            }
        }
    </style>
</head>

<body>

    <div class="app">

        <!-- MENU LATERAL -->

        <aside class="sidebar">
            <div class="logo" aria-label="Cliente360">
                <svg class="logo-icon" viewBox="0 0 48 48" role="img" aria-label="Logo Cliente360">
                    <defs>
                        <linearGradient id="c360-barras" x1="0" y1="1" x2="1" y2="0">
                            <stop offset="0%" stop-color="#11d0ed" />
                            <stop offset="100%" stop-color="#1357f6" />
                        </linearGradient>
                    </defs>
                    <path d="M5 30 Q5 27 8 26 L13 25 Q16 24 16 28 L16 40 Q16 43 13 43 L8 43 Q5 43 5 40Z" fill="#19baf6" />
                    <path d="M19 21 Q19 18 22 17 L27 16 Q30 15 30 19 L30 40 Q30 43 27 43 L22 43 Q19 43 19 40Z" fill="#2789fd" />
                    <path d="M33 11 Q33 8 36 7 L41 5 Q44 4 44 8 L44 40 Q44 43 41 43 L36 43 Q33 43 33 40Z" fill="url(#c360-barras)" />
                </svg>
                <span class="logo-name">Cliente<span class="logo-360">360</span></span>
            </div>

            <nav class="menu">

                <a href="@Url.Action("Index", "Reclamos")">
                    📋 Mis Reclamos
                </a>

                <a href="@Url.Action("Create", "Reclamos")"
                   class="active">
                    ➕ Nuevo Reclamo
                </a>

                <a href="@Url.Action("Index", "Home")">
                    🏠 Home
                </a>

                <a href="@Url.Action("Index", "Seguimiento")">
                    🔎 Seguimiento
                </a>

            </nav>

            <div class="sidebar-bottom">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" action="@Url.Action("Logout", "Account")">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-logout">🚪 Cerrar sesión</button>
                    </form>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")">🔐 Iniciar sesión</a>
                }
            </div>

        </aside>

        <!-- CONTENIDO PRINCIPAL -->

        <div class="workspace">

            <header class="topbar">

                <strong>
                    Centro de atención al cliente
                </strong>

                <div class="account">
                    👤 @(User.Identity?.Name ?? "Formulario de registro")
                </div>

            </header>

            <main class="content">

                <!-- CABECERA -->

                <section class="hero">

                    <div>
                        <h1>📝 Nuevo reclamo</h1>

                        <p>
                            Completa el formulario para registrar
                            tu reclamo en el sistema.
                        </p>
                    </div>

                    <div class="hero-icon">
                        📋
                    </div>

                </section>

                <div class="form-layout">

                    <!-- FORMULARIO -->

                    <section class="form-card">

                        <h2>Registrar reclamo</h2>

                        <p class="subtitle">
                            Ingresa los datos solicitados para
                            generar tu reclamo.
                        </p>

                        <form asp-controller="Reclamos"
                              asp-action="Create"
                              method="post">

                            @Html.AntiForgeryToken()

                            <!-- ERRORES -->

                            <div asp-validation-summary="All"
                                 class="text-danger">
                            </div>

                            <!-- INFORMACION PERSONAL -->

                            <div class="section-title">
                                <span class="section-icon">👤</span>
                                Información del solicitante
                            </div>

                            <div class="form-row">

                                <!-- NOMBRE -->

                                <div class="form-group">

                                    <label asp-for="NombreCompleto">
                                        Nombre completo
                                        <span class="required">*</span>
                                    </label>

                                    <input asp-for="NombreCompleto"
                                           class="form-control"
                                           placeholder="Ej. Juan Perez"
                                           maxlength="100"
                                           autocomplete="name"
                                           id="nombreCompleto"
                                           required />

                                    <span asp-validation-for="NombreCompleto"
                                          class="text-danger"></span>

                                </div>

                                <!-- CORREO -->

                                <div class="form-group">

                                    <label asp-for="Correo">
                                        Correo electrónico
                                        <span class="required">*</span>
                                    </label>

                                    <input asp-for="Correo"
                                           type="email"
                                           class="form-control"
                                           placeholder="ejemplo@correo.com"
                                           maxlength="100"
                                           autocomplete="email"
                                           id="correo"
                                           required />

                                    <span asp-validation-for="Correo"
                                          class="text-danger"></span>

                                </div>

                            </div>

                            <!-- DNI -->

                            <div class="form-group">

                                <label for="dni">
                                    DNI del solicitante
                                    <span class="required">*</span>
                                </label>

                                <input type="text"
                                       name="DNI"
                                       id="dni"
                                       class="form-control"
                                       placeholder="Ingrese su DNI de 8 dígitos"
                                       inputmode="numeric"
                                       minlength="8"
                                       maxlength="8"
                                       pattern="[0-9]{8}"
                                       title="El DNI debe tener 8 dígitos numéricos"
                                       required />

                                @Html.ValidationMessage(
                                "DNI",
                                                                                                                                "",
                                                                new { @class = "text-danger" }
                                                                )

                                <p class="field-hint">
                                    Ingresa los 8 dígitos de tu DNI,
                                    sin espacios ni letras.
                                </p>

                            </div>

                            <p class="field-hint">
                                Por ahora, ingresa el nombre y correo
                                de una cuenta registrada en el sistema.
                            </p>

                            <!-- INFORMACION DEL RECLAMO -->

                            <div class="section-title">
                                <span class="section-icon">📋</span>
                                Información del reclamo
                            </div>

                            <!-- TIPO DE RECLAMO -->

                            <div class="form-group">

                                <label asp-for="TipoReclamo">
                                    Tipo de reclamo
                                    <span class="required">*</span>
                                </label>

                                <select asp-for="TipoReclamo"
                                        class="form-control"
                                        id="tipoReclamo"
                                        required>

                                    <option value="">
                                        Selecciona un tipo de reclamo
                                    </option>

                                    @foreach (var tipo in tipos)
                                    {
                                        <option value="@tipo">
                                            @tipo
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="TipoReclamo"
                                      class="text-danger"></span>

                            </div>

                            <!-- DESCRIPCION -->

                            <div class="form-group">

                                <label asp-for="Descripcion">
                                    Descripción del problema
                                    <span class="required">*</span>
                                </label>

                                <textarea asp-for="Descripcion"
                                          class="form-control"
                                          id="descripcion"
                                          placeholder="Describe detalladamente el problema que estás presentando..."
                                          maxlength="500"
                                          rows="6"
                                          required></textarea>

                                <div class="counter">
                                    <span id="contador">0</span>/500 caracteres
                                </div>

                                <span asp-validation-for="Descripcion"
                                      class="text-danger"></span>

                            </div>

                            <!-- EVIDENCIA -->

                            <div class="section-title">
                                <span class="section-icon">📎</span>
                                Evidencia del reclamo
                            </div>

                            <div class="evidence-box">

                                <div class="evidence-icon">
                                    📁
                                </div>

                                <strong>
                                    Adjuntar evidencia
                                </strong>

                                <p>
                                    Próximamente podrás subir imágenes
                                    o documentos PDF.
                                </p>

                                <span class="coming-soon">
                                    Función en desarrollo
                                </span>

                            </div>

                            <!-- BOTONES -->

                            <div class="form-actions">

                                <a href="@Url.Action("Index", "Reclamos")"
                                   class="btn-cancelar">
                                    Cancelar
                                </a>

                                <button type="submit"
                                        class="btn-registrar">
                                    ＋ Registrar reclamo
                                </button>

                            </div>

                        </form>

                    </section>

                    <!-- COLUMNA DERECHA -->

                    <div class="right-column">

                        <!-- VISTA PREVIA -->

                        <section class="preview-card">

                            <div class="preview-heading">

                                <div class="preview-icon">
                                    📄
                                </div>

                                <h2>Vista previa</h2>

                            </div>

                            <p class="subtitle">
                                Así se verá la información
                                de tu reclamo.
                            </p>

                            <div class="preview-box">

                                <!-- NOMBRE -->

                                <span class="preview-label">
                                    Solicitante
                                </span>

                                <span class="preview-value"
                                      id="previewNombre">
                                    Sin completar
                                </span>

                                <!-- CORREO -->

                                <span class="preview-label">
                                    Correo electrónico
                                </span>

                                <span class="preview-value"
                                      id="previewCorreo">
                                    Sin completar
                                </span>

                                <!-- DNI -->
                             <span class="preview-label">
                      DNI del solicitante
                          </span>
             <span class="preview-value"
                 id="previewDni">
                   Sin completar
                      </span>
                            <!-- TIPO -->

                            <span class="preview-label">
                                Tipo de reclamo
                            </span>

                            <span class="preview-value"
                                  id="previewTipo">
                                Sin seleccionar
                            </span>

                            <!-- DESCRIPCION -->

                            <span class="preview-label">
                                Descripción
                            </span>

                            <span class="preview-value preview-description"
                                  id="previewDescripcion">
                                Aún no has escrito una descripción.
                            </span>

                            <!-- ESTADO -->

                            <span class="preview-label">
                                Estado inicial
                            </span>

                            <span class="badge-estado">
                                Registrado
                            </span>

                    </div>

                    <p class="preview-note">
                        El código del reclamo se generará
                        automáticamente cuando se guarde
                        correctamente en SQL Server.
                    </p>

                    </section>

                    <!-- AYUDA -->

                    <section class="help-card">

                        <h3>💡 Antes de registrar</h3>

                        <p>
                            Describe tu problema con claridad
                            y selecciona el tipo de reclamo
                            correspondiente.
                        </p>

                        <p>
                            Una vez registrado, podrás consultar
                            su estado en la sección
                            <strong>Mis Reclamos</strong>.
                        </p>

                    </section>

                </div>

        </div>

        </main>

    </div>

    </div>

    <!-- JAVASCRIPT -->

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const nombre = document.getElementById("nombreCompleto");
            const correo = document.getElementById("correo");
            const dni = document.getElementById("dni");
            const tipo = document.getElementById("tipoReclamo");
            const descripcion = document.getElementById("descripcion");

            const previewNombre = document.getElementById("previewNombre");
            const previewCorreo = document.getElementById("previewCorreo");
            const previewDni = document.getElementById("previewDni");
            const previewTipo = document.getElementById("previewTipo");
            const previewDescripcion = document.getElementById("previewDescripcion");

            const contador = document.getElementById("contador");

            // PERMITIR SOLO NUMEROS EN DNI

            dni.addEventListener("input", function () {
                dni.value = dni.value.replace(/\D/g, "").slice(0, 8);
                actualizarVistaPrevia();
            });

            // ACTUALIZAR VISTA PREVIA

            function actualizarVistaPrevia() {

                previewNombre.textContent =
                    nombre.value.trim() || "Sin completar";

                previewCorreo.textContent =
                    correo.value.trim() || "Sin completar";

                const numeroDni = dni.value.trim();

                previewDni.textContent =
                    numeroDni.length === 8
                        ? "••••" + numeroDni.slice(-4)
                        : "Sin completar";

                previewTipo.textContent =
                    tipo.value || "Sin seleccionar";

                previewDescripcion.textContent =
                    descripcion.value.trim() ||
                    "Aún no has escrito una descripción.";

                contador.textContent = descripcion.value.length;
            }

            // EVENTOS

            nombre.addEventListener("input", actualizarVistaPrevia);
            correo.addEventListener("input", actualizarVistaPrevia);
            tipo.addEventListener("change", actualizarVistaPrevia);
            descripcion.addEventListener("input", actualizarVistaPrevia);

            actualizarVistaPrevia();

        });
    </script>

</body>
</html>