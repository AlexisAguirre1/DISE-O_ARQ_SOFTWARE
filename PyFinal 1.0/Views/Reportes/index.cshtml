@model PyFinal_1.ViewModels.Reportes.ReporteVM

@{
    Layout = null;
    ViewData["Title"] = "Reportes - Cliente360";

    string nombre = User.Identity?.Name ?? "Supervisor";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Reportes - Cliente360</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #f3f7ff;
            color: #101b3e;
        }

        .app {
            display: flex;
            min-height: 100vh;
        }

        /* MENU LATERAL */

        .sidebar {
            width: 260px;
            flex-shrink: 0;
            background: white;
            padding: 28px 14px;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 20px #dae5f550;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 23px;
            font-weight: 800;
            color: #101b3e;
            padding: 0 13px;
            margin-bottom: 55px;
        }

        .logo-icon {
            display: flex;
            align-items: end;
            gap: 3px;
            height: 34px;
        }

            .logo-icon span {
                width: 9px;
                border-radius: 4px;
                background: linear-gradient(#20c8f7, #0963f6);
            }

                .logo-icon span:nth-child(1) {
                    height: 15px;
                }

                .logo-icon span:nth-child(2) {
                    height: 24px;
                }

                .logo-icon span:nth-child(3) {
                    height: 34px;
                }

        .logo-360 {
            color: #1589fa;
        }

        .menu {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

            .menu a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 17px 20px;
                border-radius: 13px;
                text-decoration: none;
                color: #263c64;
                transition: .3s;
            }

                .menu a:hover {
                    background: #e9f3ff;
                    color: #0866f5;
                    transform: translateX(5px);
                }

                .menu a.active {
                    background: linear-gradient( 120deg, #e8f2ff, #dff7ff);
                    color: #0866f5;
                    border-left: 4px solid #0866f5;
                    font-weight: 700;
                }

        .sidebar-bottom {
            margin-top: auto;
            padding: 20px;
        }

        .logout {
            background: transparent;
            border: none;
            padding: 0;
            color: #df4760;
            font-weight: 700;
            cursor: pointer;
        }

        /* CONTENIDO */

        .workspace {
            flex: 1;
            min-width: 0;
        }

        .topbar {
            min-height: 82px;
            background: linear-gradient( 110deg, #3288fb, #8fe4f4);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 18px 35px;
            color: white;
        }

        .account {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #ffffffdd;
            border-radius: 35px;
            color: #183762;
            padding: 10px 18px;
        }

            .account small {
                display: block;
                color: #7184a4;
                margin-top: 4px;
            }

        .content {
            padding: 35px;
            max-width: 1500px;
            margin: auto;
        }

        /* CABECERA */

        .hero {
            margin-bottom: 29px;
            animation: aparecer .6s ease both;
        }

            .hero h1 {
                margin: 0 0 12px;
                font-size: 38px;
            }

            .hero p {
                color: #7184a4;
                font-size: 16px;
                line-height: 1.6;
            }

        /* ESTADISTICAS */

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 25px;
        }

        .stat {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 25px;
            border-radius: 17px;
            background: white;
            box-shadow: 0 5px 20px #dce6f54d;
            transition: .3s;
        }

            .stat:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 30px #bed4f580;
            }

        .stat-icon {
            width: 54px;
            height: 54px;
            flex-shrink: 0;
            border-radius: 14px;
            background: #e8f2ff;
            display: grid;
            place-items: center;
            font-size: 25px;
        }

        .stat:nth-child(2) .stat-icon {
            background: #fff3d7;
        }

        .stat:nth-child(3) .stat-icon {
            background: #def8ef;
        }

        .stat strong {
            display: block;
            font-size: 29px;
        }

        .stat small {
            font-size: 13px;
            color: #7184a4;
        }

        /* PANEL PRINCIPAL */

        .panel {
            background: white;
            border-radius: 20px;
            padding: 27px;
            box-shadow: 0 8px 25px #dce6f54d;
            animation: aparecer .8s ease both;
        }

            .panel h2 {
                margin: 0 0 8px;
                font-size: 24px;
            }

        .panel-subtitle {
            color: #7184a4;
            margin: 0 0 24px;
            line-height: 1.6;
        }

        .search-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 23px;
        }

        .search, .filter {
            padding: 14px;
            border-radius: 12px;
            border: 1px solid #dce8f8;
            background: #f5f9ff;
            outline: none;
            font-size: 14px;
            color: #263c64;
        }

        .search {
            flex: 1;
            max-width: 480px;
            min-width: 220px;
        }

            .search:focus, .filter:focus {
                border-color: #2583fc;
                box-shadow: 0 0 0 4px #2583fc1a;
            }

        /* TABLA */

        .table-scroll {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 920px;
            font-size: 14px;
        }

        thead {
            background: #edf4ff;
        }

        th, td {
            padding: 17px;
            text-align: left;
            vertical-align: top;
        }

        td {
            border-bottom: 1px solid #e8edf5;
        }

        tbody tr:hover {
            background: #f7faff;
        }

        .codigo {
            color: #ed1683;
            font-weight: 800;
        }

        .descripcion {
            max-width: 290px;
            line-height: 1.65;
            overflow-wrap: anywhere;
        }

        .estado {
            display: inline-block;
            border-radius: 9px;
            padding: 8px 12px;
            background: #e8edf4;
            color: #4d5d78;
            font-weight: 700;
            font-size: 12px;
            white-space: nowrap;
        }

            .estado.proceso {
                background: #e3efff;
                color: #0761df;
            }

            .estado.resuelto {
                background: #dbf8ec;
                color: #11855e;
            }

        /* FORMULARIO DE ATENCION */

        .form-atencion {
            width: 245px;
            max-width: 100%;
        }

            .form-atencion label {
                display: block;
                font-weight: 700;
                font-size: 13px;
                margin-bottom: 9px;
            }

        .observacion {
            display: block;
            width: 100%;
            min-height: 88px;
            padding: 12px;
            resize: vertical;
            border: 1px solid #dce8f8;
            background: #f5f9ff;
            border-radius: 10px;
            outline: none;
            font: inherit;
            font-size: 13px;
            color: #263c64;
        }

            .observacion:focus {
                background: white;
                border-color: #2583fc;
                box-shadow: 0 0 0 3px #2583fc1a;
            }

        .ayuda {
            display: block;
            color: #8190a8;
            font-size: 11px;
            margin: 8px 0 13px;
            line-height: 1.5;
        }

        .acciones {
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .btn-avance, .btn-resolver {
            width: 100%;
            border: none;
            border-radius: 10px;
            padding: 12px 14px;
            color: white;
            font: inherit;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: .3s;
        }

        .btn-avance {
            background: linear-gradient( 120deg, #3288fb, #0866f5);
        }

        .btn-resolver {
            background: linear-gradient( 120deg, #25b98b, #11966c);
        }

            .btn-avance:hover,
            .btn-resolver:hover {
                transform: translateY(-2px);
                filter: brightness(.97);
            }

        .sin-acciones {
            color: #7184a4;
            font-size: 13px;
        }

        /* MENSAJES */

        .alert {
            padding: 16px 20px;
            border-radius: 12px;
            margin-bottom: 22px;
            line-height: 1.6;
        }

        .alert-ok {
            background: #def8ef;
            color: #11855e;
        }

        .alert-error {
            background: #fff0f2;
            color: #ba3651;
        }

        .empty {
            text-align: center;
            padding: 35px 15px;
            color: #8190a8;
        }

        .footer {
            padding-top: 20px;
            color: #8190a8;
            font-size: 13px;
        }

        /* ANIMACIONES */

        @@keyframes aparecer {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* RESPONSIVE */

        @@media (max-width: 1100px) {
            .stats {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 750px) {
            .app {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
            }

            .logo {
                margin-bottom: 20px;
            }

            .menu {
                flex-direction: row;
                overflow-x: auto;
            }

                .menu a {
                    white-space: nowrap;
                }

            .content {
                padding: 18px;
            }

            .topbar {
                padding: 15px;
            }

            .hero h1 {
                font-size: 29px;
            }

            .panel {
                padding: 18px;
            }
        }

        /* ---- REPORTES ---- */

        .filtros {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            align-items: flex-end;
            margin-bottom: 25px;
            background: white;
            padding: 20px 24px;
            border-radius: 17px;
            box-shadow: 0 5px 20px #dce6f54d;
        }

            .filtros label {
                display: block;
                font-weight: 700;
                font-size: 13px;
                margin-bottom: 8px;
            }

            .filtros input[type=date] {
                padding: 12px;
                border-radius: 12px;
                border: 1px solid #dce8f8;
                background: #f5f9ff;
                font: inherit;
                font-size: 14px;
                color: #263c64;
            }

        .btn-filtrar {
            border: none;
            border-radius: 12px;
            padding: 13px 22px;
            background: linear-gradient(120deg, #3288fb, #0866f5);
            color: white;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
        }

        .btn-limpiar {
            padding: 13px 18px;
            border-radius: 12px;
            text-decoration: none;
            color: #4d5d78;
            background: #e8edf4;
            font-weight: 700;
            font-size: 14px;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 25px;
        }

        .bar-row {
            margin-bottom: 16px;
        }

        .bar-top {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            font-size: 14px;
            margin-bottom: 6px;
        }

            .bar-top span {
                color: #7184a4;
            }

        .bar-track {
            height: 12px;
            border-radius: 8px;
            background: #e8f0fc;
            overflow: hidden;
        }

        .bar-fill {
            height: 100%;
            border-radius: 8px;
            background: linear-gradient(120deg, #3288fb, #20c8f7);
        }

        .badge-libre, .badge-ocupado {
            display: inline-block;
            border-radius: 9px;
            padding: 6px 11px;
            font-weight: 700;
            font-size: 12px;
        }

        .badge-libre {
            background: #dbf8ec;
            color: #11855e;
        }

        .badge-ocupado {
            background: #fff0f2;
            color: #ba3651;
        }

        .stat small.sub {
            display: block;
            margin-top: 3px;
            font-size: 11px;
        }

        @@media (max-width: 1100px) {
            .grid-2 {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <div class="app">

        <!-- MENU LATERAL -->

        <aside class="sidebar">

            <div class="logo">

                <div class="logo-icon">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

                <span>
                    Cliente<span class="logo-360">360</span>
                </span>

            </div>

            <partial name="_MenuLateral" />


            <div class="sidebar-bottom">

                <form method="post"
                      action="@Url.Action("Logout", "Account")">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="logout">
                        🚪 Cerrar sesión
                    </button>

                </form>

            </div>

        </aside>

        <!-- AREA PRINCIPAL -->

        <div class="workspace">

            <header class="topbar">

                <strong>
                    Centro de atención al cliente
                </strong>

                <div class="account">

                    <span>👤</span>

                    <div>
                        <strong>@nombre</strong>
                        <small>Supervisor</small>
                    </div>

                </div>

            </header>

            <main class="content">

                <section class="hero">

                    <h1>📊 Reportes estadísticos</h1>

                    <p>
                        Consulta cuántos reclamos hay por estado y por tipo,
                        la carga de los operarios y el tiempo promedio de resolución.
                    </p>

                </section>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-error">
                        ⚠️ @TempData["Error"]
                    </div>
                }

                <!-- FILTRO POR FECHA DE REGISTRO -->

                <form method="get"
                      action="@Url.Action("Index", "Reportes")"
                      class="filtros">

                    <div>
                        <label for="desde">Registrados desde</label>
                        <input type="date"
                               id="desde"
                               name="desde"
                               value="@(Model.Desde?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <div>
                        <label for="hasta">Hasta</label>
                        <input type="date"
                               id="hasta"
                               name="hasta"
                               value="@(Model.Hasta?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <button type="submit" class="btn-filtrar">
                        🔍 Filtrar
                    </button>

                    <a href="@Url.Action("Index", "Reportes")"
                       class="btn-limpiar">
                        Limpiar
                    </a>

                </form>

                <!-- RESUMEN -->

                <section class="stats">

                    <div class="stat">
                        <div class="stat-icon">📋</div>

                        <div>
                            <strong>@Model.Total</strong>
                            <small>Total de reclamos</small>
                        </div>
                    </div>

                    <div class="stat">
                        <div class="stat-icon">⏱️</div>

                        <div>
                            <strong>@Model.TiempoPromedioResolucion</strong>
                            <small>Tiempo promedio de resolución</small>
                            <small class="sub">
                                Según @Model.ReclamosConResolucion reclamo(s) con resolución registrada
                            </small>
                        </div>
                    </div>

                    <div class="stat">
                        <div class="stat-icon">✅</div>

                        <div>
                            <strong>@Model.Finalizados</strong>
                            <small>Resueltos o cerrados</small>
                        </div>
                    </div>

                </section>

                <!-- POR ESTADO Y POR TIPO -->

                <div class="grid-2">

                    <section class="panel">

                        <h2>📍 Reclamos por estado</h2>

                        <p class="panel-subtitle">
                            Cantidad de reclamos en cada etapa del proceso.
                        </p>

                        @foreach (var item in Model.PorEstado)
                        {
                            <div class="bar-row">
                                <div class="bar-top">
                                    <strong>@item.Nombre</strong>
                                    <span>@item.Cantidad (@item.Porcentaje%)</span>
                                </div>

                                <div class="bar-track">
                                    <div class="bar-fill"
                                         style="width:@(item.Porcentaje)%"></div>
                                </div>
                            </div>
                        }

                    </section>

                    <section class="panel">

                        <h2>🏷️ Reclamos por tipo</h2>

                        <p class="panel-subtitle">
                            Qué tipos de reclamo se presentan con más frecuencia.
                        </p>

                        @if (!Model.PorTipo.Any())
                        {
                            <div class="empty">
                                No hay reclamos en el período seleccionado.
                            </div>
                        }

                        @foreach (var item in Model.PorTipo)
                        {
                            <div class="bar-row">
                                <div class="bar-top">
                                    <strong>@item.Nombre</strong>
                                    <span>@item.Cantidad (@item.Porcentaje%)</span>
                                </div>

                                <div class="bar-track">
                                    <div class="bar-fill"
                                         style="width:@(item.Porcentaje)%"></div>
                                </div>
                            </div>
                        }

                    </section>

                </div>

                <!-- CARGA DE OPERARIOS -->

                <section class="panel">

                    <h2>🛠️ Carga de operarios</h2>

                    <p class="panel-subtitle">
                        Situación actual de cada operario. Esta tabla no depende
                        del filtro de fechas.
                    </p>

                    <div class="table-scroll">

                        <table>

                            <thead>
                                <tr>
                                    <th>Operario</th>
                                    <th>Especialidad</th>
                                    <th>En proceso</th>
                                    <th>Resueltos</th>
                                    <th>Cerrados</th>
                                    <th>Disponibilidad</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var o in Model.Operarios)
                                {
                                    <tr>
                                        <td>@o.Nombre</td>
                                        <td>@o.Tipo</td>
                                        <td>@o.EnProceso</td>
                                        <td>@o.Resueltos</td>
                                        <td>@o.Cerrados</td>
                                        <td>
                                            @if (o.Disponible)
                                            {
                                                <span class="badge-libre">Libre</span>
                                            }
                                            else
                                            {
                                                <span class="badge-ocupado">Ocupado</span>
                                            }
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                    @if (!Model.Operarios.Any())
                    {
                        <div class="empty">
                            No hay operarios registrados.
                        </div>
                    }

                </section>

            </main>

        </div>

    </div>

</body>
</html>