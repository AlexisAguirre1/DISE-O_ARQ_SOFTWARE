@model List<PyFinal_1.ViewModels.Reclamos.EvidenciaItemVM>

@if (Model.Any())
{
    <div style="margin-top:10px">
        @foreach (var e in Model)
        {
            <a href="@Url.Action("Descargar", "Evidencias", new { id = e.Id })"
               target="_blank"
               style="display:inline-block;margin:4px 6px 0 0;padding:6px 11px;border-radius:9px;background:#e8f2ff;color:#0761df;font-size:12px;font-weight:700;text-decoration:none">
                📎 @e.Nombre (@e.TamanoLegible)
            </a>
        }
    </div>
}